NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://radar:radar_local@localhost:5432/radar?schema=public
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-with-at-least-32-characters
ADMIN_EMAIL=admin@radar.local
ADMIN_PASSWORD=admin123

# Optional copy generation. Template remains fallback when either value is empty.
OPENAI_API_KEY=
OPENAI_MODEL=

# Amazon Creators API (BR). Keep empty to leave Amazon import disabled.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br
AMAZON_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_API_URL=https://creatorsapi.amazon

# Telegram destinations use their own bot token in the current MVP.
TELEGRAM_BOT_TOKEN=

# Evolution API. Enable after connecting an instance through QR Code.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-evolution-key
EVOLUTION_INSTANCE=radar

# Docker services
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_local
POSTGRES_DB=radar
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:v2.3.7
